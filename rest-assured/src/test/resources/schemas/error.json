{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error":   { "type": "string", "minLength": 1 },
    "details": {}
  },
  "comment": "An error body carries a message and nothing that leaks internals.",
  "not": {
    "anyOf": [
      { "required": ["stack"] },
      { "required": ["stacktrace"] },
      { "required": ["query"] },
      { "required": ["sql"] }
    ]
  }
}
