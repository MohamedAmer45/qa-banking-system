{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id", "user_id", "account_number", "iban", "account_type", "currency",
      "balance_minor", "available_minor", "status", "daily_limit_minor",
      "opened_at"
    ],
    "properties": {
      "id":               { "type": "integer" },
      "user_id":          { "type": "integer" },
      "account_number":   { "type": "string", "pattern": "^[0-9]+$" },
      "iban":             { "type": "string", "pattern": "^EG[0-9]{2}" },
      "account_type":     { "enum": ["CURRENT", "SAVINGS"] },
      "currency":         { "enum": ["EGP", "USD", "EUR", "GBP"] },

      "balance_minor":      { "type": "integer" },
      "available_minor":    { "type": "integer" },
      "daily_limit_minor":  { "type": "integer" },

      "status": { "enum": ["ACTIVE", "FROZEN", "DORMANT", "CLOSED"] },
      "opened_at": { "type": "string" },
      "closed_at": { "type": ["string", "null"] }
    },
    "not": {
      "anyOf": [
        { "required": ["password_hash"] },
        { "required": ["mfa_code"] }
      ]
    }
  }
}
