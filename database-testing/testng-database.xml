<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Single-threaded: the cross-layer tests move real money and assert on the
     resulting rows, so parallel execution would make each one observe the
     others' effects. -->
<suite name="NovaBank Database" verbose="1" parallel="false">

    <!-- Schema first: if the constraints are wrong, the behavioural failures
         below are consequences rather than separate findings. -->
    <test name="Schema and constraints">
        <classes>
            <class name="com.bankingsystem.qa.db.schema.ConstraintTest"/>
        </classes>
    </test>

    <test name="Ledger persistence and rollback">
        <classes>
            <class name="com.bankingsystem.qa.db.ledger.TransferPersistenceTest"/>
        </classes>
    </test>

    <test name="Concurrency">
        <classes>
            <class name="com.bankingsystem.qa.db.ledger.ConcurrencyTest"/>
        </classes>
    </test>

    <test name="History preservation">
        <classes>
            <class name="com.bankingsystem.qa.db.history.HistoryPreservationTest"/>
        </classes>
    </test>

    <!-- Integrity last: it sweeps the whole database, so running it after the
         behavioural tests also proves they left nothing inconsistent. -->
    <test name="Referential integrity">
        <classes>
            <class name="com.bankingsystem.qa.db.integrity.ReferentialIntegrityTest"/>
        </classes>
    </test>

</suite>
