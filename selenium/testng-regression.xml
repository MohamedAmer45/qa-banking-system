<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Full suite. Single-threaded on purpose: the money-movement tests assert on
     balances, and parallel execution against one seeded database would make
     them order-dependent. -->
<suite name="NovaBank Regression" verbose="1" parallel="false">
    <test name="Regression">
        <packages>
            <package name="com.bankingsystem.qa.tests"/>
        </packages>
    </test>
</suite>
